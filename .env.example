# Server-side only. Never expose to the frontend.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Postgres / pgvector. Default points at the local Docker container in
# infra/docker-compose.yml (docker compose -f infra/docker-compose.yml up -d).
DATABASE_URL=postgresql://interview_copilot:interview_copilot_dev@127.0.0.1:5433/interview_copilot

# GitHub — a personal access token is the simplest path for a single-user
# desktop tool (Settings -> Developer settings -> Fine-grained tokens;
# needs at least read access to repository contents & metadata).
GITHUB_TOKEN=
# Optional: only needed if using the OAuth Device Flow connect UI instead
# of a PAT (requires "Device Flow" enabled on a registered GitHub OAuth App).
GITHUB_CLIENT_ID=

# Web research provider (optional, Phase 7). Tavily has a free tier with no
# credit card required: https://app.tavily.com
WEB_SEARCH_API_KEY=
