# Server-side only. Never expose to the frontend.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Postgres / pgvector. Default points at the local Docker container in
# infra/docker-compose.yml (docker compose -f infra/docker-compose.yml up -d).
DATABASE_URL=postgresql://interview_copilot:interview_copilot_dev@127.0.0.1:5433/interview_copilot

# GitHub — the desktop app's "Connect GitHub" button uses OAuth Device Flow
# by default and works with zero setup (it authorizes against this project's
# own public OAuth App). Leave GITHUB_TOKEN blank and just click Connect.
#
# Alternative path: paste a personal access token instead, either here or
# directly in the GitHub page's UI (Settings -> Developer settings ->
# Fine-grained tokens; needs at least read access to repository contents &
# metadata). Useful if you'd rather skip the browser step entirely.
GITHUB_TOKEN=
# Optional: only set this if you want Device Flow to authorize against your
# own registered GitHub OAuth App instead of this project's (must have
# "Device Flow" enabled in that App's settings).
GITHUB_CLIENT_ID=

# Web research provider (optional, Phase 7). Tavily has a free tier with no
# credit card required: https://app.tavily.com
WEB_SEARCH_API_KEY=
